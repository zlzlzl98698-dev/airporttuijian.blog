# ====================================================================
# Apache 2.4+ Production Configuration for VitePress Static Site
# Domain: airporttuijian.blog
# Features: cleanUrls, HTTPS enforcement, deep routing, caching & security
# ====================================================================

# 1. 基础配置
Options -Indexes +FollowSymLinks
DirectoryIndex index.html

# 2. 真实 404 错误页处理（避免未知路径返回 200 假状态）
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3. 强制 HTTPS 规范跳转
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 4. VitePress cleanUrls 路由映射支持
  # 如果请求的是实际存在的文件或目录，直接提供服务
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 如果请求的路径存在对应的 .html 文件，内部重写为 .html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # 如果请求的是目录路径，且目录下存在 index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/$ /$1/index.html [L]
</IfModule>

# 5. 静态资源客户端缓存控制
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML 页面：及时重新验证
  ExpiresByType text/html "access plus 0 seconds"

  # CSS 与 JavaScript：带 hash 的静态打包文件长效缓存 1 年
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # 图片与字体资源
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 6. 安全响应头
<IfModule mod_headers.c>
  # 阻止 MIME 类型嗅探
  Header set X-Content-Type-Options "nosniff"

  # 防点击劫持
  Header set X-Frame-Options "SAMEORIGIN"

  # 跨域安全推荐策略
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # 对动态 HTML 资源设置 no-cache 协商缓存
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # 对带哈希的资产设置不可变强缓存
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 7. MIME 类型规范与 Gzip 压缩
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
