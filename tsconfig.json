{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./docs/*"]
    }
  },
  "include": ["docs/**/*.ts", "docs/**/*.vue", "docs/**/*.d.ts", "scripts/**/*.js"]
}
